function load(k) {
  nodes = []; links = []; nid = 1; sel = null; first = null;
  const s = SC[k];
  if (s) {
    const m = s.N.map(a => {
      const n = add(a[0], a[3], a[4], a[1]);
      const c = a[2];
      if (c) { const i = c.i; const r = Object.assign({}, c); delete r.i; Object.assign(n, r); }
      return n;
    });
    s.L.forEach(function(pair) { links.push({ id: nid++, a: m[pair[0]].id, b: m[pair[1]].id }); });
    s.N.forEach(function(a, i) {
      const c = a[2];
      if (c && c.i) for (const li in c.i) m[i].ifs[links[+li].id] = { ip: c.i[li], mask: '255.255.255.0' };
    });
    $('#log').innerHTML = ''; say(s.m, 'h');
    $('#hint').textContent = s.m;
  } else {
    $('#log').innerHTML = ''; say('Réseau vide — construis ta topologie.', 'h');
    $('#hint').textContent = 'Ajoute des équipements et relie-les.';
  }
  draw(); panel();
}
$('#sc').onchange = e => { if (e.target.value) load(e.target.value); };
